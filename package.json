{
  "name": "inkstone-epub-uploader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Automated EPUB -> Webnovel Inkstone chapter publisher",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "signin": "node src/signin.mjs",
    "grab": "node src/grab-cookies.mjs",
    "import": "node src/import-cookies.mjs",
    "publish": "node src/publish.mjs",
    "publish:all": "node src/publish.mjs",
    "inspect": "node src/inspect.mjs",
    "probe": "node src/probe-login.mjs",
    "cleanup:drafts": "node src/cleanup-drafts.mjs",
    "add:book": "node src/add-book.mjs",
    "add:batch": "node src/add-batch.mjs",
    "push:vault": "bash scripts/push-vault.sh",
    "check:workflows": "python check-workflows.py",
    "test": "node src/lib/books.test.mjs",
    "vault:unpack": "node src/vault.mjs unpack",
    "vault:pack": "node src/vault.mjs pack",
    "vault:seal": "node src/vault.mjs seal"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "node-html-parser": "^6.1.13",
    "playwright": "^1.49.1"
  }
}
